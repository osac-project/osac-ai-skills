[4.019025, "o", "\u001b[H\u001b[2J\u001b[3J"]
[4.020157, "o", "\r\n\u001b[1;36m  ╭──────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[1;36m  │\u001b[0m  \u001b[1mOSAC quota — VMaaS: the request path\u001b[0m\r\n\u001b[1;36m  ╰──────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[6.022298, "o", "  \u001b[2mThe tenant user asks for a VM. The provider sets the limits.\u001b[0m\r\n"]
[7.524502, "o", "  \u001b[2mShorthand: $RHCOS is the disk image, $SUBNET and $SG are the\u001b[0m\r\n"]
[9.026638, "o", "  \u001b[2mtenant's default subnet and security group.\u001b[0m\r\n"]
[11.530591, "o", "\r\n"]
[11.530737, "o", "\u001b[1;36m── 1 · No limits have been set ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[13.132154, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaDefaultLimits/List\u001b[0m\r\n"]
[16.127924, "o", "\u001b[1;39m{}\u001b[0m\r\n"]
[16.128913, "o", "  \u001b[2mThe provider has not set a single limit. Until it does, every limit is zero.\u001b[0m\r\n"]
[17.631987, "o", "\r\n"]
