[28.383119, "o", "\u001b[0m\r\n"]
[31.268233, "o", "  \u001b[1;31mError: failed to create compute instance: rpc error: code = FailedPrecondition desc = quota exceeded: tenant tenant1, compute.memory_gib: limit 0, usage 0, adding 4\u001b[0m\r\n"]
[31.268509, "o", "  \u001b[1;31m✗\u001b[0m Refused. The ask is 2 vCPUs and 4 GiB. The memory limit is zero.\r\n"]
[32.770658, "o", "  \u001b[2mNothing was created:\u001b[0m\r\n"]
[35.013148, "o", "There are no objects matching the given criteria.\r\n\r\n"]
[35.018993, "o", "  \u001b[2mThe CLI prints one line. The API also returns the reason as data:\u001b[0m\r\n"]
[36.52139, "o", "\r\n\u001b[1;32m❯ tenant user\u001b[0m  \u001b[1mgrpcurl … osac.public.v1.ComputeInstances/Create\u001b[0m\r\n"]
[40.173799, "o", "  CODE       FailedPrecondition (9)\r\n  MESSAGE    quota exceeded: tenant tenant1, compute.memory_gib: limit 0, usage 0, adding 4\r\n  REASON     QUOTA_EXCEEDED\r\n  DIMENSION  compute.memory_gib\r\n"]
[40.173832, "o", "  ADDED      4\r\n  SOURCES    spec.instance_type\r\n  SCOPE      tenant\r\n"]
[40.173969, "o", "\r\n\u001b[1;36m── 3 · The provider sets the limits ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[41.775356, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaDefaultLimits/Create (five dimensions)\u001b[0m\r\n"]
[44.631549, "o", "  compute.vcpus              = 10\r\n"]
[46.050506, "o", "  compute.memory_gib         = 20\r\n"]
[47.453806, "o", "  storage.volumes            = 10\r\n"]
[48.837284, "o", "  storage.local.gib          = 100\r\n"]
[50.094283, "o", "  network.virtual_networks   = 10\r\n"]
[50.397555, "o", "  \u001b[2mLimits are per dimension and cover the whole tenant.\u001b[0m\r\n"]
[53.027355, "o", "  compute.memory_gib  limit 20  usage 0\r\n  compute.vcpus  limit 10  usage 0\r\n"]
[53.029176, "o", "  \u001b[2mThe room is there and nothing is used yet.\u001b[0m\r\n"]
[54.531187, "o", "\r\n"]
[54.531523, "o", "\u001b[1;36m── 4 · The same ask, now with room ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[56.133611, "o", "\r\n\u001b[1;32m❯ tenant user\u001b[0m  \u001b[1mosac create computeinstance --catalog-item demo-vm --name vm1 …\u001b[0m\r\n"]
[58.596645, "o", "Created compute instance '01a217cd-4ff8-7897-aa0a-e029fe3d3005'.\r\n"]
[58.607235, "o", "  \u001b[1;32m✓\u001b[0m Created. Quota was checked inside the create, before any host work.\r\n"]
[60.009484, "o", "  \u001b[2mThe VM is starting; that part is not the quota's business.\u001b[0m\r\n"]
[62.432374, "o", "TENANT   DELETING  PROJECT  ID                                    NAME  TEMPLATE     DISK IMAGE  STATE     INTERNAL IP ADDRESS  EXTERNAL IP ADDRESS\r\ntenant1  -         -        01a217cd-4ff8-7897-aa0a-e029fe3d3005  vm1   ocp-virt-vm"]
[62.432633, "o", "  rhcos-4-22  STARTING                       \r\n"]
[63.204026, "o", "  \u001b[1;33m⏳\u001b[0m vm1 state: COMPUTE_INSTANCE_STATE_STARTING\r\n"]
[90.092597, "o", "\r\n"]
[90.093185, "o", "\u001b[1;36m── 5 · Tighten the limit to what is already used ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[91.696245, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaUsage/Get (vCPUs in use)\u001b[0m\r\n"]
[94.441087, "o", "  compute.vcpus: limit 10, usage 2\r\n"]
[94.441722, "o", "\r\n"]
[94.441866, "o", "\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaDefaultLimits/Update (compute.vcpus = 2)\u001b[0m\r\n"]
[97.485129, "o", "  compute.vcpus = 2\r\n"]
[97.485728, "o", "\r\n"]
[97.485905, "o", "\u001b[1;32m❯ tenant user\u001b[0m  \u001b[1mosac create computeinstance --catalog-item demo-vm --name vm2 …\u001b[0m\r\n"]
[101.065113, "o", "  \u001b[1;31mError: failed to create compute instance: rpc error: code = FailedPrecondition desc = quota exceeded: tenant tenant1, compute.vcpus: limit 2, usage 2, adding 2\u001b[0m\r\n"]
[101.065544, "o", "  \u001b[1;31m✗\u001b[0m Refused: the tenant holds 2 vCPUs, the limit is 2, the second VM adds 2.\r\n"]
[102.567842, "o", "\r\n"]
[102.568115, "o", "\u001b[1;36m── 6 · The usage report ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[104.17035, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaUsage/Get (tenant1)\u001b[0m\r\n"]
[105.772695, "o", "  DIMENSION                 LIMIT  USAGE\r\n"]
[107.060644, "o", "  compute.memory_gib           20      4\r\n  compute.vcpus                 2      2\r\n  storage.local.gib           100      5\r\n  storage.volumes              10      1\r\n"]
[107.061574, "o", "  \u001b[2mThe same numbers the refusal named: limit 2, usage 2.\u001b[0m\r\n"]
[108.564099, "o", "\r\n"]
[108.56431, "o", "\u001b[1;36m── 7 · Clean up ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[110.166931, "o", "\r\n\u001b[1;32m❯ tenant user\u001b[0m  \u001b[1mosac delete computeinstance vm1\u001b[0m\r\n"]
[112.707386, "o", "Deleted computeinstance '01a217cd-4ff8-7897-aa0a-e029fe3d3005'.\r\n"]
[194.415045, "o", "  \u001b[1;32m✓\u001b[0m VM deleted.\r\n"]
[197.430464, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaDefaultLimits/Delete (the five we set)\u001b[0m\r\n"]
[214.327108, "o", "  \u001b[1;32m✓\u001b[0m Limits left set: 0\r\n"]
[215.729396, "o", "\r\n"]
[215.729778, "o", "  \u001b[2mBack where we started: no limits, no VM.\u001b[0m\r\n"]
