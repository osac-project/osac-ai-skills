{"version": 2, "width": 160, "height": 40, "timestamp": 1795695898, "idle_time_limit": 3.0, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}, "title": "OSAC quota — CaaS: a cluster's ask and its hosts"}
[2.007096, "o", "\u001b[H\u001b[2J\u001b[3J"]
[2.007716, "o", "\r\n\u001b[1;36m  ╭──────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[1;36m  │\u001b[0m  \u001b[1mOSAC quota — CaaS: a cluster's ask and its hosts\u001b[0m\r\n\u001b[1;36m  ╰──────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[4.008707, "o", "  \u001b[2mThe tenant user asks for a cluster. The provider sets the limits.\u001b[0m\r\n"]
[5.510762, "o", "  \u001b[2mEach worker is one bare-metal host from the provider's pool.\u001b[0m\r\n"]
[8.014688, "o", "\r\n"]
[8.014954, "o", "\u001b[1;36m── 1 · The hosts and the limits ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[9.616768, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1moc get bmh -n host-inventory\u001b[0m\r\n"]
[12.277009, "o", "NAME                      STATE       CONSUMER   ONLINE   ERROR   AGE\r\nvirtual-bmh-f72e980f-0c   available              true             8d"]
[12.277283, "o", "\r\nvirtual-bmh-f72e980f-76   available              true             8d\r\nvirtual-bmh-f72e980f-7a   available              true             8d\r\nvirtual-bmh-f72e980f-81   available              true             8d\r\nvirtual-bmh-f72e980f-d6   available              true             8d\r\nvirtual-bmh-f72e980f-f3   available              true             8d\r\n"]
[12.285519, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaDefaultLimits/List\u001b[0m\r\n"]
[15.263239, "o", "\u001b[1;39m{}\u001b[0m\r\n"]
[15.263696, "o", "  \u001b[2mSix hosts are free, but the host dimension has no limit.\u001b[0m\r\n"]
[16.76585, "o", "\r\n"]
[16.76611, "o", "\u001b[1;36m── 2 · The provider gives room for one cluster ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[18.368886, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaDefaultLimits/Create (two dimensions)\u001b[0m\r\n"]
[21.393977, "o", "  bare_metal.instances.demo-worker-bm = 3\r\n"]
[22.788057, "o", "  caas.control_planes                = 2\r\n"]
[22.788422, "o", "  \u001b[2mThree hosts: exactly one cluster at the demo-cluster size of three.\u001b[0m\r\n"]
[24.291001, "o", "\r\n\u001b[1;36m── 3 · The tenant asks for a cluster ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
