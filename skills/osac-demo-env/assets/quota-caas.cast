[345.45031, "o", "  \u001b[1;32m✓\u001b[0m All three hosts are running.\r\n"]
[346.852474, "o", "\r\n"]
[346.852829, "o", "\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … BareMetalInstances/List (the cluster's hosts)\u001b[0m\r\n"]
[351.558126, "o", "  289fa04b-975b-47bd-b87f-01fcc10b2e46  RUNNING\r\n"]
[351.55836, "o", "  a8c0151d-f9b9-46fe-981c-b707653ba4b1  RUNNING\r\n  577cb33c-b1a4-4f71-be05-04b61b11a1cf  RUNNING\r\n"]
[353.585373, "o", "TENANT   DELETING  PROJECT  ID                                    NAME  TEMPLATE      VERSION  STATE        API URL  CONSOLE URL  API ENDPOINT  INGRESS ENDPOINT\r\ntenant1  -"]
[353.585449, "o", "         -        01a217d1-6f9d-77e4-8847-f258754d9640  c1    ocp-ci-small  4.22.0   PROGRESSING  -        -            -             -\r\n"]
[353.591216, "o", "  \u001b[2mThe cluster is still installing. The quota part is already settled.\u001b[0m\r\n"]
[355.093104, "o", "\r\n\u001b[1;36m── 6 · The hosts replace the ask ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[356.694512, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1moc get bmh -n host-inventory | grep provisioned\u001b[0m\r\n"]
[359.358264, "o", "  3 provisioned\r\n"]
[359.358342, "o", "\r\n"]
[359.358523, "o", "\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaUsage/Get (after the hosts exist)\u001b[0m\r\n"]
[362.060817, "o", "  bare_metal.instances.demo-worker-bm  limit 3  usage 3\r\n"]
[362.061416, "o", "  \u001b[2mStill three. The hosts replaced the ask; they did not add to it.\u001b[0m\r\n"]
[363.563617, "o", "\r\n"]
[363.563855, "o", "\u001b[1;36m── 7 · One more cluster, one more host — both refused ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[365.165746, "o", "\r\n\u001b[1;32m❯ tenant user\u001b[0m  \u001b[1mosac create cluster --catalog-item demo-cluster --name c2 …\u001b[0m\r\n"]
[367.64362, "o", "  \u001b[1;31mError: failed to create cluster: rpc error: code = FailedPrecondition desc = quota exceeded: tenant tenant1, bare_metal.instances.demo-worker-bm: limit 3, usage 3, adding 3\u001b[0m\r\n"]
[367.643701, "o", "  \u001b[1;31m✗\u001b[0m A second cluster needs three more hosts. The limit is three.\r\n"]
[369.145801, "o", "\r\n\u001b[1;32m❯ tenant user\u001b[0m  \u001b[1mosac scale cluster c1 --node-set workers --size 4\u001b[0m\r\n"]
[371.662164, "o", "  \u001b[1;31mError: failed to scale cluster: rpc error: code = FailedPrecondition desc = quota exceeded: tenant tenant1, bare_metal.instances.demo-worker-bm: limit 3, usage 3, adding 1\u001b[0m\r\n"]
[371.662419, "o", "  \u001b[1;31m✗\u001b[0m One more host is one too many.\r\n"]
[373.164372, "o", "\r\n"]
[373.164644, "o", "\u001b[1;36m── 8 · Raise the limit by one ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[374.766867, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaDefaultLimits/Update (bare_metal.instances.demo-worker-bm = 4)\u001b[0m\r\n"]
[377.762977, "o", "  bare_metal.instances.demo-worker-bm = 4\r\n"]
[377.763434, "o", "\r\n"]
[377.76346, "o", "\u001b[1;32m❯ tenant user\u001b[0m  \u001b[1mosac scale cluster c1 --node-set workers --size 4\u001b[0m\r\n"]
[380.289034, "o", "  \u001b[1;32mScaled cluster '01a217d1-6f9d-77e4-8847-f258754d9640' node set 'workers': 3 → 4\r\nRun 'osac describe cluster 01a217d1-6f9d-77e4-8847-f258754d9640' to monitor reconciliation.\u001b[0m\r\n"]
[380.289296, "o", "  \u001b[1;32m✓\u001b[0m The same command now passes. Nothing restarts: the limit is live.\r\n"]
[382.792415, "o", "  bare_metal.instances.demo-worker-bm  limit 4  usage 4\r\n"]
[382.792747, "o", "  \u001b[2mFour hosts count; the fourth is being created now.\u001b[0m\r\n"]
[384.294117, "o", "\r\n\u001b[1;36m── 9 · Clean up ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[385.896199, "o", "\r\n\u001b[1;32m❯ tenant user\u001b[0m  \u001b[1mosac delete cluster c1\u001b[0m\r\n"]
[388.469022, "o", "  \u001b[1;32mDeleted cluster '01a217d1-6f9d-77e4-8847-f258754d9640'.\u001b[0m\r\n"]
[389.405969, "o", "  \u001b[1;33m⏳\u001b[0m teardown running · 1s\r\n"]
[421.334606, "o", "  \u001b[1;33m⏳\u001b[0m teardown running · 33s\r\n"]
[453.264044, "o", "  \u001b[1;33m⏳\u001b[0m teardown running · 65s\r\n"]
[485.167433, "o", "  \u001b[1;33m⏳\u001b[0m teardown running · 96s\r\n"]
[517.101493, "o", "  \u001b[1;33m⏳\u001b[0m teardown running · 128s\r\n"]
[548.304703, "o", "  \u001b[2mTeardown continues on its own; the hosts return to the pool.\u001b[0m\r\n"]
[549.806154, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaDefaultLimits/Delete (the two we set)\u001b[0m\r\n"]
[558.344807, "o", "  \u001b[1;32m✓\u001b[0m Limits left set: 0\r\n"]
[559.7462, "o", "\r\n  \u001b[2mThe hosts drain back to available as teardown finishes.\u001b[0m\r\n"]
