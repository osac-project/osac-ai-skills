[29.704172, "o", "\u001b[0m\r\n"]
[32.626696, "o", "  \u001b[1;32mCreated cluster '01a217d1-6f9d-77e4-8847-f258754d9640'.\u001b[0m\r\n"]
[32.626951, "o", "  \u001b[1;32m✓\u001b[0m Accepted. The ask is three hosts and the limit is three.\r\n"]
[35.218461, "o", "TENANT   DELETING  PROJECT  ID                                    NAME  TEMPLATE      VERSION  STATE        API URL  CONSOLE URL  API ENDPOINT  INGRESS ENDPOINT"]
[35.218742, "o", "\r\ntenant1  -         -        01a217d1-6f9d-77e4-8847-f258754d9640  c1    ocp-ci-small  4.22.0   PROGRESSING  -        -            -             -\r\n"]
[36.025136, "o", "\r\n\u001b[1;36m── 4 · The ask counts at once ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[37.630054, "o", "\r\n\u001b[1;35m❯ provider admin\u001b[0m  \u001b[1mgrpcurl … QuotaUsage/Get (right after the create)\u001b[0m\r\n"]
[40.356858, "o", "  bare_metal.instances.demo-worker-bm  limit 3  usage 3\r\n"]
[41.457629, "o", "  caas.control_planes  limit 2  usage 1\r\n"]
[41.458179, "o", "  \u001b[2mThree hosts count now, before a single host exists.\u001b[0m\r\n"]
[42.960291, "o", "\r\n\u001b[1;36m── 5 · The operator creates the hosts ─────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[44.561754, "o", "  \u001b[2mThe cluster asked for three workers; the operator is finding them.\u001b[0m\r\n"]
[47.503981, "o", "  \u001b[1;33m⏳\u001b[0m 3 of 3 hosts created · 0 running · 2s\r\n"]
