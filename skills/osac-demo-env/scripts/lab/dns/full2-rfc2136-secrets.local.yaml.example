# Template for the gitignored full2-rfc2136-secrets.local.yaml.
#
# Copy to full2-rfc2136-secrets.local.yaml next to this file and paste the
# secret from the TSIG key file on the hypervisor:
#
#   grep secret /etc/named/osac-demo-keys/osac-full2-lab.key
#
# Paste the base64 string between the quotes exactly as printed. Helm
# values for aap.instanceGroups...secret are plaintext: the chart's patch
# script base64-encodes them once more when it writes the Kubernetes
# Secret (osac-installer/docs/aap-configuration.md, "Secret Variables").
#
# full2-rfc2136-secrets.local.yaml is excluded by .gitignore in this
# directory. Never commit it.
aap:
  instanceGroups:
    clusterFulfillment:
      secret:
        DNS_RFC2136_KEY_SECRET: "<base64 secret from osac-full2-lab.key>"
