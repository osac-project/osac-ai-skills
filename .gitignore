# Credentials and config
.env
.env.*
.envrc
*.pem
*.key

# Editor / OS
*.swp
*.swo
*~
.idea/
.vscode/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Agent discovery dirs (regenerated by tools/link-agent-skills.sh). .claude/
# is only *partly* generated: rules/, agents/, and hooks/ hold real canonical
# content (fanned out to consumers as-is; no ../rules, ../agents, or ../hooks
# top-level dir needed), while skills/ and commands/ stay symlinked/vendored
# output. hooks/ holds only shared *documentation* (README.md) — this repo
# has no hook scripts of its own to run.
.claude/*
!.claude/rules/
!.claude/agents/
!.claude/hooks/
.cursor/
.gemini/
.agents/
.mcp.json

# Vendored flightctl/ai-workflows (consumer bootstrap; optional locally)
.ai-workflows/

# Workflow artifacts
.artifacts/
.artifacts/*

# skillsaw baseline not used — strict lint only
.skillsaw-baseline.json
**/.skillsaw-baseline.json

# Eval harness checkout and run output (see evals/review/.gitignore)
evals/review/.harness/
evals/review/results/
evals/review/artifacts/

# Optional flightctl/ai-workflows skill symlinks under skills/ (consumer wiring)
skills/bugfix
skills/e2e
skills/implement
skills/prd
skills/design
skills/_shared
